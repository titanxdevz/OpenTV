<?xml version="1.0" encoding="utf-8"?>
<!-- Single app tile in the horizontal row. No border in the tile itself —
     the GlassView floats on top and provides the focus highlight. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="112dp"
    android:layout_marginEnd="14dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="true"
    android:clipToOutline="true"
    android:background="@drawable/row_tile_bg">

    <!-- Banner image (shown when app declares a banner) -->
    <ImageView
        android:id="@+id/row_app_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"/>

    <!-- Icon fallback (centered in a dark card) -->
    <FrameLayout
        android:id="@+id/row_app_icon_wrap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/row_app_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"/>

    </FrameLayout>

    <!-- App name — fades in on focus, fades out on blur -->
    <TextView
        android:id="@+id/row_app_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit"
        android:maxLines="1"
        android:ellipsize="end"
        android:alpha="0"
        android:background="#88000000"/>

</FrameLayout>
