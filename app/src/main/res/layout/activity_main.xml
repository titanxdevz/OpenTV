<?xml version="1.0" encoding="utf-8"?>
<!--
  CleanYourTV-style launcher layout.
  Layer order (back to front):
    1. SkyView        — time-of-day gradient fill
    2. heroArt        — blurred banner backdrop (very low alpha)
    3. ambient        — radial palette glow
    4. Content        — greeting, clock, pills, hero name, row
    5. GlassView      — floating spring highlight on top of everything
    6. LoadingShimmer — hidden after apps load
  Settings / Wi-Fi open the real system pages (no custom overlay).
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- 1. Sky gradient (time-of-day) -->
    <com.clean.launcher.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>

    <!-- 2. Cinematic hero art (very low alpha, stretched) -->
    <ImageView
        android:id="@+id/hero_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no"/>

    <!-- 3. Ambient radial glow -->
    <com.clean.launcher.AmbientView
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"/>

    <!-- 4. Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false">

        <!-- Top row: left block (greeting+clock+date) + right pills -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <!-- Left: greeting + clock row + date -->
            <LinearLayout
                android:id="@+id/left_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/top_buttons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true"
                    android:text="GOOD AFTERNOON"/>

                <!-- Clock + AM/PM + divider + date on one baseline row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <!-- Auto-updating clock (no Handler needed) -->
                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="56sp"
                        android:fontFamily="@font/outfit"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false"/>

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"/>

                    <!-- Thin vertical divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="9dp"
                        android:background="#33FFFFFF"/>

                    <!-- Date (auto-updating) -->
                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="10dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:format12Hour="EEEE, d MMMM"
                        android:format24Hour="EEEE, d MMMM"
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Right: pill buttons aligned to bottom of left block -->
            <LinearLayout
                android:id="@+id/top_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/left_block"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/btn_inputs"
                    style="@style/PillButton"
                    android:text="  Inputs"
                    android:drawableStart="@drawable/ic_inputs"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/pill_text"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/btn_wifi"
                    style="@style/PillButton"
                    android:text="  Wi-Fi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/pill_text"
                    android:maxWidth="160dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/btn_settings"
                    style="@style/PillButton"
                    android:text="  Settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/pill_text"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- Flexible spacer pushes hero+row to the bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Hero block: focused app name (fades in/out on focus change) -->
        <LinearLayout
            android:id="@+id/hero_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:alpha="0"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/hero_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#FFFFFFFF"
                android:textSize="48sp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- App row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:layout_marginBottom="40dp">

            <!-- Loading shimmer (shown while apps load) -->
            <LinearLayout
                android:id="@+id/loading_shimmer"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:orientation="horizontal">

                <View android:layout_width="200dp" android:layout_height="112dp"
                    android:background="#1AFFFFFF" android:layout_marginEnd="14dp"/>
                <View android:layout_width="200dp" android:layout_height="112dp"
                    android:background="#14FFFFFF" android:layout_marginEnd="14dp"/>
                <View android:layout_width="200dp" android:layout_height="112dp"
                    android:background="#10FFFFFF" android:layout_marginEnd="14dp"/>
                <View android:layout_width="200dp" android:layout_height="112dp"
                    android:background="#0CFFFFFF"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/app_row"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:focusable="true"
                android:descendantFocusability="afterDescendants"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"/>

            <!-- Scroll position indicator bar — sits below the row -->
            <com.clean.launcher.RowIndicatorView
                android:id="@+id/row_indicator"
                android:layout_width="120dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="-10dp"
                android:alpha="0"/>

        </FrameLayout>

    </LinearLayout>

    <!-- 5. GlassView — full-screen canvas; springs to the focused tile -->
    <com.clean.launcher.GlassView
        android:id="@+id/glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:focusable="false"
        android:clickable="false"
        android:importantForAccessibility="no"/>

</FrameLayout>
